{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polerolero",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polerolero",
      "database_id": "ca7549b3-16f0-4381-b992-df9d716b208e",
      "migrations_dir": "migrations"
    }
  ],
  // Presence and reactions are the one thing here that needs coordination.
  // The feed deliberately does not — see due_at scheduling in src/index.ts.
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "triggers": {
    // PAUSED on 1 Oct 2026, by decision, not by failure. An empty array is what
    // actually clears the trigger on Cloudflare — omitting the key leaves the
    // existing schedule in place.
    //
    // Everything else stays up: the worker still serves /api/messages, the
    // archive of ~20k messages is still browsable, and the Durable Object
    // still answers. Nothing generates, so nothing is billed.
    //
    // To restart: put ["*/5 * * * *"] back and deploy. The buffer refills
    // itself and the feed resumes — topUp is written around keeping a buffer
    // full, not around having run recently, so a month-long gap is the same
    // code path as a five-minute one.
    "crons": []
  },
  "vars": {
    "AI_GATEWAY_ACCOUNT_ID": "55dd6d847f366735ef6e0f860c7bdc51",
    "AI_GATEWAY_NAME": "default",
    // BYOK for openrouter is configured in the Gateway dashboard, so the Worker
    // carries no provider key — only CF_AI_GATEWAY_TOKEN (secret).
    "LLM_PROVIDER": "openrouter",
    "LLM_MODEL": "z-ai/glm-5.3-flash",
    "BUFFER_TARGET": "20",
    "MAX_PER_RUN": "10",
    "MAX_PER_DAY": "1600",
    "MESSAGE_INTERVAL_SECONDS": "60",
    // 1º turno: 4 de outubro de 2026. Res.-TSE 23.610 art. 9º-B §3º-A veda
    // publicar conteúdo sintético novo sobre candidato de 72h antes até 24h
    // depois do pleito — o rótulo não supre. Horários em UTC (BRT = UTC-3).
    "BLACKOUT_FROM": "2026-10-01T20:00:00Z",
    "BLACKOUT_TO": "2026-10-05T20:00:00Z"
  },
  // Cloudflare builds from main on push, and a clean clone has no dist/ — this
  // makes `wrangler deploy` self-sufficient instead of depending on whatever
  // build command the dashboard happens to have configured.
  "build": { "command": "bun install && bun run build" },
  "observability": { "enabled": true }
}
